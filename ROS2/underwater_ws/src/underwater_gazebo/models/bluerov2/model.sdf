<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="bluerov2">
    <link name="base_link">
      <inertial>
        <mass>11.5</mass>
        <inertia>
          <ixx>0.16</ixx><iyy>0.16</iyy><izz>0.28</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry><box><size>0.46 0.34 0.25</size></box></geometry>
      </collision>

      <visual name="body_visual">
        <geometry><box><size>0.46 0.34 0.25</size></box></geometry>
        <material><diffuse>1.0 0.82 0.1 1</diffuse></material>
      </visual>

      <sensor name="front_camera" type="camera">
        <pose>0.24 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>50.0</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <topic>/camera/image_raw</topic>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>/imu/data</topic>
      </sensor>
    </link>

    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <xUabsU>-18.18</xUabsU><yVabsV>-21.66</yVabsV><zWabsW>-36.99</zWabsW>
      <xU>-4.03</xU><yV>-6.22</yV><zW>-5.18</zW>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/odom</odom_topic>
    </plugin>
  </model>
</sdf>
